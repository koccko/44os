#!/bin/sh
# One-time per-user 44OS 0.4 desktop setup; leaves existing installed users alone.
marker="$HOME/.config/44os-layout-v04.done"
[ -f "$marker" ] && exit 0
mkdir -p "$HOME/.config"
command -v plasma-apply-colorscheme >/dev/null 2>&1 && plasma-apply-colorscheme 44OSPetrolCopper >/dev/null 2>&1 || true
command -v plasma-apply-wallpaperimage >/dev/null 2>&1 && plasma-apply-wallpaperimage /usr/share/wallpapers/44OS/contents/images/1920x1080.svg >/dev/null 2>&1 || true
# Remove Debian desktop installer shortcut only when our own launcher is present.
if [ -f "$HOME/Desktop/Install 44OS.desktop" ]; then
  for f in "$HOME/Desktop/Install Debian.desktop" "$HOME/Desktop/install-debian.desktop"; do [ ! -f "$f" ] || rm -f "$f"; done
fi
# Use qdbus6 to configure panels after PlasmaShell starts.
i=0
while [ "$i" -lt 30 ]; do
  if command -v qdbus6 >/dev/null 2>&1 && qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$(cat /usr/share/44os/44os-layout.js)" >/dev/null 2>&1; then
    touch "$marker"; exit 0
  fi
  i=$((i+1)); sleep 2
done
exit 0
